/** Generates docs/FEATURES.md (client-facing) from src/content/guide.ts and src/lib/plan.ts. Run: npm run docs */
import { writeFileSync } from "node:fs";
import { GUIDE } from "../src/content/guide";
import { FEATURES, PLANS, PLAN_INFO, hasFeature, isSoon, type Feature } from "../src/lib/plan";

const lim = (n: number) => (Number.isFinite(n) ? String(n) : "Unlimited");
const head = `| | ${PLANS.map((p) => PLAN_INFO[p].name).join(" | ")} |\n|---|${PLANS.map(() => "---").join("|")}|`;
const rows = [
	`| Products | ${PLANS.map((p) => lim(PLAN_INFO[p].limits.products)).join(" | ")} |`,
	`| Staff accounts | ${PLANS.map((p) => lim(PLAN_INFO[p].limits.staff)).join(" | ")} |`,
	`| Orders, payments, shipping, order emails, appearance | ${PLANS.map(() => "✓").join(" | ")} |`,
	...(Object.keys(FEATURES) as Feature[]).map((f) => `| ${FEATURES[f].label} | ${PLANS.map((p) => (hasFeature(f, p) ? (isSoon(f) ? "Soon" : "✓") : "–")).join(" | ")} |`),
];

const sections = GUIDE.map((s) => {
	const entries = s.entries.map((e) => {
		const min = e.feature ? FEATURES[e.feature].minPlan : null;
		const tier = e.feature && min ? ` · _${PLAN_INFO[min].name}${min === PLANS.at(-1) ? " plan" : " and above"}${isSoon(e.feature) ? ", coming soon" : ""}_` : "";
		return [
			`### ${e.title}${tier}`,
			"",
			e.summary,
			e.steps ? `\n${e.steps.map((st, i) => `${i + 1}. ${st}`).join("\n")}` : "",
			e.tips ? `\n${e.tips.map((t) => `> ${t}`).join("\n>\n")}` : "",
		].join("\n");
	});
	return `## ${s.title}\n\n${entries.join("\n\n")}`;
});

const md = `<!-- Generated by \`npm run docs\` from src/content/guide.ts. Do not edit by hand. -->
# Store guide

How every part of your store works. The same guide is in your dashboard under **Guide**.

## Plans at a glance

${head}
${rows.join("\n")}

${sections.join("\n\n")}
`;
writeFileSync(new URL("../docs/FEATURES.md", import.meta.url), md);
console.log("docs/FEATURES.md written");
