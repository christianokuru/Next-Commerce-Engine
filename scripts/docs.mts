/**
 * Generates docs/FEATURES.md for ONE plan: only the features that store has, nothing about other tiers.
 * Plan: PLAN env var, else the "PLAN" in wrangler.jsonc.  Run: npm run docs  (or PLAN=starter npm run docs)
 */
import { readFileSync, writeFileSync } from "node:fs";
import { visibleGuide } from "../src/content/guide";
import { FEATURES, PLANS, PLAN_INFO, availableFeatures, isAvailable, type Plan } from "../src/lib/plan";

const fromWrangler = readFileSync(new URL("../wrangler.jsonc", import.meta.url), "utf8").match(/"PLAN"\s*:\s*"(\w+)"/)?.[1];
const plan = (process.env.PLAN ?? fromWrangler ?? "standard").toLowerCase() as Plan;
if (!PLANS.includes(plan)) throw new Error(`Unknown plan: ${plan}`);
const l = PLAN_INFO[plan].limits;
const lim = (n: number) => (Number.isFinite(n) ? String(n) : "Unlimited");

const included = [
	`- Products: ${lim(l.products)}`,
	`- Staff accounts: ${lim(l.staff)}`,
	"- Orders & payments, shipping & order emails, products & categories, appearance",
	...availableFeatures(plan).map((f) => `- ${FEATURES[f].label}`),
];

const sections = visibleGuide((f) => isAvailable(f, plan), l).map((s) => {
	const entries = s.entries.map((e) =>
		[
			`### ${e.title}`,
			"",
			e.summary,
			e.steps ? `\n${e.steps.map((st, i) => `${i + 1}. ${st}`).join("\n")}` : "",
			e.tips ? `\n${e.tips.map((t) => `> ${t}`).join("\n>\n")}` : "",
		].join("\n"),
	);
	return `## ${s.title}\n\n${entries.join("\n\n")}`;
});

const md = `<!-- Generated by \`npm run docs\` from src/content/guide.ts. Do not edit by hand. -->
# Store guide

How every part of your store works. The same guide is in your dashboard under **Guide**.

## What's included

${included.join("\n")}

${sections.join("\n\n")}
`;
writeFileSync(new URL("../docs/FEATURES.md", import.meta.url), md);
console.log(`docs/FEATURES.md written for the ${PLAN_INFO[plan].name} plan`);
