# `npm run dev` needs NONE of this. Everything is optional locally.
# `npm run preview`: copy the values you need into .dev.vars. Production: `wrangler secret put NAME`.

# Required only for preview/production. Leave commented for the built-in local database.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# BETTER_AUTH_SECRET=   # generate with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
# SETUP_TOKEN=          # protects /setup in production

# Tier & region (defaults locally: advanced + africa, so you can try everything)
# PLAN=starter            # starter | standard | advanced | multivendor
# REGION=africa           # africa | international
# ALLOWED_PAYMENT_PROVIDERS=paystack,stripe
# UPGRADE_CONTACT=+2348012345678

APP_URL=http://localhost:3000
STORE_NAME=My Store

# Email (Resend). Without a key, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=My Store <orders@yourdomain.com>

# Payments (enable each provider in Admin → Settings)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated storefront origins allowed to call /api/store/* from the browser
STORE_CORS=
TRUSTED_ORIGINS=
