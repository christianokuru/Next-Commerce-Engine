# Copy to .env.local (next dev) and .dev.vars (wrangler preview). Production: `wrangler secret put NAME`.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
APP_URL=http://localhost:3000
SETUP_TOKEN=one-time-token-for-first-admin
STORE_NAME=My Store

# Email (Resend). Without a key, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=My Store <orders@yourdomain.com>

# Payments (enable each provider in Admin → Settings)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated storefront origins allowed to call /api/store/* from the browser
STORE_CORS=
TRUSTED_ORIGINS=
