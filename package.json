{
	"name": "next-commerce-engine",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.mts",
		"test:neon": "TEST_DATABASE_URL=$DATABASE_URL vitest run tests/checkout.test.ts",
		"e2e": "node tests/e2e/workers-e2e.mjs"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@neondatabase/serverless": "^1.2.1",
		"@opennextjs/cloudflare": "^1.20.3",
		"better-auth": "^1.7.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.76.0",
		"next": "16.4.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1",
		"shadcn": "^4.23.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.17",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9",
		"eslint-config-next": "16.4.5",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5.7.4",
		"vitest": "^5.1.1",
		"wrangler": "^4.134.0"
	}
}
